<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        权限说明（刻意保持最小集合）：
        · POST_NOTIFICATIONS  —— Android 13+ 发送系统通知所需
        · RECEIVE_BOOT_COMPLETED —— 开机后恢复后台任务与桌面小组件
        注意：本应用不声明 INTERNET 权限，也不引入任何网络库，完全离线运行。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Android 11+ 包可见性：只声明界面上可选的那几个包，不做全量扫描，
        也没有申请 QUERY_ALL_PACKAGES。
        这份列表必须与 gradle.properties 的 appwatch.candidates 保持一致。
    -->
    <queries>
        <package android:name="com.mobiletools.systemhelper" />
        <package android:name="com.miui.systemAdSolution" />
        <package android:name="com.miui.analytics" />
        <package android:name="com.miui.msa.global" />
        <package android:name="com.xiaomi.mipicks" />
        <package android:name="com.miui.hybrid" />
        <package android:name="com.miui.video" />
        <package android:name="com.miui.news" />
        <package android:name="com.miui.browser" />
        <package android:name="com.xiaomi.gamecenter" />
        <package android:name="com.xiaomi.gsgservice" />
        <package android:name="com.miui.miservice" />
        <package android:name="com.xiaomi.market" />
        <package android:name="com.iflytek.inputmethod.miui" />
        <package android:name="com.miui.cleanmaster" />

        <!--
            用户自行添加目标：声明桌面启动器这一种 intent。
            这样普通带图标的应用可以被查询到，手输包名才有意义。
            这仍然不是 QUERY_ALL_PACKAGES——无图标的后台类系统应用依然不可见，
            想监控那种必须把包名逐个写进上面的 <package> 列表。
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AppWatchApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppWatch">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppWatch"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件 -->
        <receiver
            android:name=".widget.MonitorWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/monitor_widget_info" />
        </receiver>

        <!-- 开机 / 应用更新后恢复监控 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
